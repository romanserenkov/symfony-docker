# syntax=docker/dockerfile:1
FROM php:8.6-cli-alpine AS base
RUN apk add --no-cache git unzip icu-dev oniguruma-dev \
    && docker-php-ext-install -j"$(nproc)" intl opcache
WORKDIR /app
COPY composer.json composer.lock symfony.lock ./
RUN curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer \
    && COMPOSER_ALLOW_SUPERUSER=1 composer install --prefer-dist --no-scripts --no-progress
COPY . .
RUN mkdir -p var && chmod -R 777 var
EXPOSE 8000
CMD ["php", "-S", "0.0.0.0:8000", "-t", "public"]
